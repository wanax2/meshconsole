# Second radio: Station G3 (or the G2) on USB, dashboard on :8081, nightly export at 03:05.
# Use the stable by-id path (ls /dev/serial/by-id/) rather than /dev/ttyACM0, which can swap at boot.
MC_ARGS=--port /dev/serial/by-id/REPLACE-WITH-YOUR-DEVICE --data /home/pi/mesh_data2 --web 8081 --export 03:05 --export-dir /home/pi/mesh_exports/NE --label NE
